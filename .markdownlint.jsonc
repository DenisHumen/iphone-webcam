{
  // Проект использует компактный технический стиль документации.
  // Отключены косметические правила, конфликтующие с этим стилем
  // (на рендеринг в GitHub/любом просмотрщике не влияют).
  "default": true,
  "MD013": false, // длина строки — намеренно длинные строки и таблицы
  "MD060": false, // стиль пробелов в таблицах — используем стандартные пробелы вокруг |
  "MD022": false, // пустые строки вокруг заголовков — компактные ADR/секции
  "MD032": false, // пустые строки вокруг списков — компактный стиль
  "MD031": false, // пустые строки вокруг кодовых блоков
  "MD040": false, // язык для кодовых блоков — ASCII-схемы без языка
  "MD033": false  // инлайн-HTML — <br/> в Mermaid-диаграммах и т. п.
}
